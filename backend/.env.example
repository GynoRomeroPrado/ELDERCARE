# ELDERCARE+ Backend API - Environment Configuration Template
# Copy this file to .env and update with your actual values

# ===== Application Configuration =====
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===== Database Configuration (PostgreSQL + TimescaleDB) =====
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=eldercare
DB_USERNAME=eldercare
DB_PASSWORD=your_secure_database_password_here
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ===== Redis Configuration =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DB=0
REDIS_TTL=3600

# ===== JWT Authentication =====
JWT_SECRET=your_jwt_secret_min_32_characters_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# ===== AWS Configuration =====
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# AWS IoT Core
AWS_IOT_ENDPOINT=your-iot-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_THING_GROUP=eldercare-devices

# AWS S3
AWS_S3_BUCKET_TELEMETRY=eldercare-telemetry-data
AWS_S3_BUCKET_UPLOADS=eldercare-user-uploads
AWS_S3_BUCKET_BACKUPS=eldercare-backups

# AWS SQS
AWS_SQS_ALERTS_QUEUE=eldercare-alerts-queue
AWS_SQS_EVENTS_QUEUE=eldercare-events-queue

# ===== Twilio Configuration (Telemedicine & SMS) =====
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VIDEO_API_KEY=your_twilio_video_api_key
TWILIO_VIDEO_API_SECRET=your_twilio_video_api_secret

# ===== Email Configuration (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@eldercare.com
SMTP_FROM_NAME=ELDERCARE+

# ===== Firebase Configuration (Push Notifications) =====
FIREBASE_PROJECT_ID=eldercare-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@eldercare-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour Firebase private key here\n-----END PRIVATE KEY-----\n"

# ===== CORS Configuration =====
CORS_ORIGINS=https://app.eldercare.com,https://admin.eldercare.com

# ===== Logging Configuration =====
LOG_LEVEL=info
LOG_FORMAT=json

# CloudWatch Logs (AWS)
CLOUDWATCH_LOG_GROUP=/eldercare/backend
CLOUDWATCH_LOG_STREAM=api

# ===== Security Configuration =====
# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Encryption
ENCRYPTION_KEY=your_encryption_key_min_32_characters
ENCRYPTION_IV_LENGTH=16

# ===== Monitoring & Alerting =====
# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# PagerDuty (Critical alerts)
PAGERDUTY_INTEGRATION_KEY=your_pagerduty_integration_key

# DataDog (APM)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# ===== External Services =====
# Google Maps (Location services)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Stripe (Payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===== Feature Flags =====
ENABLE_TELEMETRY=true
ENABLE_FALL_DETECTION=true
ENABLE_MEDICATION_REMINDERS=true
ENABLE_TELEMEDICINE=true
ENABLE_FAMILY_COORDINATION=true

# ===== Development Tools =====
# Enable Swagger documentation
ENABLE_SWAGGER=true

# Enable debug mode
DEBUG=false

# ===== Testing Configuration =====
# Use these values for test environment
TEST_DB_DATABASE=eldercare_test
TEST_DB_USERNAME=eldercare_test
TEST_DB_PASSWORD=test_password

# ===== Compliance & Regulatory =====
# HIPAA audit logging
HIPAA_AUDIT_LOG_ENABLED=true
HIPAA_AUDIT_LOG_RETENTION_DAYS=2555

# Data retention policies
DATA_RETENTION_TELEMETRY_DAYS=365
DATA_RETENTION_EVENTS_DAYS=2555
DATA_RETENTION_LOGS_DAYS=2555

# ===== Business Logic Configuration =====
# Fall detection thresholds
FALL_DETECTION_CONFIDENCE_THRESHOLD=0.85
FALL_ALERT_DELAY_SECONDS=30

# Medication reminders
MEDICATION_REMINDER_ADVANCE_MINUTES=15
MEDICATION_MISSED_THRESHOLD_MINUTES=60

# Emergency response
EMERGENCY_AUTO_CALL_DELAY_SECONDS=120
EMERGENCY_CONTACT_MAX_ATTEMPTS=3

# ===== Background Jobs =====
# Job queue configuration
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=your_queue_redis_password

# Job schedules (cron expressions)
CRON_TELEMETRY_CLEANUP=0 2 * * *
CRON_DEVICE_HEALTH_CHECK=*/5 * * * *
CRON_MEDICATION_REMINDERS=* * * * *
CRON_ANALYTICS_AGGREGATION=0 1 * * *
