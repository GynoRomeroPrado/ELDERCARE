# ELDERCARE+ Test Environment Configuration
# Configuration for running automated tests

NODE_ENV=test
PORT=3001

# Test Database (separate from development)
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=eldercare_test
DB_USERNAME=eldercare_test
DB_PASSWORD=test_password
DB_SSL=false
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=test_redis_password
REDIS_DB=15
REDIS_TTL=300

# JWT (Test secrets - not for production)
JWT_SECRET=test_jwt_secret_for_testing_only_32_chars_min
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test_jwt_refresh_secret_for_testing_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# AWS (Mock services in tests)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test_access_key
AWS_SECRET_ACCESS_KEY=test_secret_key
AWS_IOT_ENDPOINT=test.iot.us-east-1.amazonaws.com

# Twilio (Mock)
TWILIO_ACCOUNT_SID=test_account_sid
TWILIO_AUTH_TOKEN=test_auth_token
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_VIDEO_API_KEY=test_video_key
TWILIO_VIDEO_API_SECRET=test_video_secret

# Email (Mock)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_FROM=test@eldercare.test

# Firebase (Mock)
FIREBASE_PROJECT_ID=eldercare-test
FIREBASE_CLIENT_EMAIL=test@eldercare-test.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTEST_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# Logging
LOG_LEVEL=error
LOG_FORMAT=simple

# Security
ENCRYPTION_KEY=test_encryption_key_32_characters
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# Feature Flags (all enabled for testing)
ENABLE_TELEMETRY=true
ENABLE_FALL_DETECTION=true
ENABLE_MEDICATION_REMINDERS=true
ENABLE_TELEMEDICINE=true
ENABLE_FAMILY_COORDINATION=true
ENABLE_SWAGGER=false

# Testing specific
TEST_TIMEOUT=30000
SKIP_EXTERNAL_SERVICES=true
