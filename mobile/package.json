{
  "name": "eldercare-mobile",
  "version": "1.0.0",
  "description": "ELDERCARE+ Mobile App - Family Coordination for Aging in Place",
  "author": "ELDERCARE+ Engineering Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "tsc": "tsc --noEmit",
    "pod-install": "cd ios && pod install && cd ..",
    "clean": "cd android && ./gradlew clean && cd .. && cd ios && xcodebuild clean && cd ..",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace ElderCare.xcworkspace -scheme ElderCare -configuration Release",
    "e2e:ios": "detox test --configuration ios.sim.release",
    "e2e:android": "detox test --configuration android.emu.release"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.72.6",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/drawer": "^6.6.6",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.27.0",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-reanimated": "^3.5.4",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "redux-persist": "^6.0.0",
    "@react-native-async-storage/async-storage": "^1.19.5",
    "socket.io-client": "^4.6.2",
    "axios": "^1.6.0",
    "react-native-webrtc": "^111.0.6",
    "@twilio/voice-react-native-sdk": "^1.0.0",
    "react-native-firebase": "^5.6.0",
    "@react-native-firebase/app": "^18.6.1",
    "@react-native-firebase/messaging": "^18.6.1",
    "@react-native-firebase/crashlytics": "^18.6.1",
    "@react-native-firebase/analytics": "^18.6.1",
    "react-native-permissions": "^3.10.1",
    "react-native-device-info": "^10.11.0",
    "react-native-biometrics": "^3.0.1",
    "react-native-keychain": "^8.1.2",
    "react-native-calendar-events": "^2.2.0",
    "react-native-contacts": "^7.0.8",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-maps": "^1.8.3",
    "react-native-svg": "^14.0.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-image-picker": "^5.7.0",
    "react-native-document-picker": "^9.1.1",
    "react-native-share": "^10.0.0",
    "react-native-voice": "^3.2.4",
    "dayjs": "^1.11.10",
    "formik": "^2.4.5",
    "yup": "^1.3.3",
    "react-native-vector-icons": "^10.0.2",
    "react-native-elements": "^3.4.3",
    "react-native-paper": "^5.11.1",
    "react-native-toast-message": "^2.1.7",
    "react-native-modal": "^13.0.1",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-sqlite-storage": "^6.0.1",
    "i18next": "^23.7.6",
    "react-i18next": "^13.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/runtime": "^7.23.4",
    "@react-native/eslint-config": "^0.72.2",
    "@react-native/metro-config": "^0.72.11",
    "@tsconfig/react-native": "^3.0.2",
    "@types/react": "^18.2.37",
    "@types/react-test-renderer": "^18.0.5",
    "babel-jest": "^29.7.0",
    "eslint": "^8.53.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "0.76.8",
    "prettier": "^3.1.0",
    "react-test-renderer": "18.2.0",
    "typescript": "5.2.2",
    "detox": "^20.13.5",
    "@testing-library/react-native": "^12.4.1",
    "@testing-library/jest-native": "^5.4.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
