#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🧪 Running tests before push..."

# Run unit tests
echo "Running unit tests..."
cd backend && npm run test:unit

if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Please fix before pushing."
  exit 1
fi

# Run E2E tests
echo "Running E2E tests..."
npm run test:e2e

if [ $? -ne 0 ]; then
  echo "❌ E2E tests failed. Please fix before pushing."
  exit 1
fi

# Verify test coverage
echo "Checking test coverage..."
npm run test:cov -- --silent

COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
MIN_COVERAGE=80

if (( $(echo "$COVERAGE < $MIN_COVERAGE" | bc -l) )); then
  echo "❌ Coverage $COVERAGE% is below minimum $MIN_COVERAGE%"
  exit 1
fi

echo "✅ All tests passed with $COVERAGE% coverage!"
echo "🚀 Ready to push!"
